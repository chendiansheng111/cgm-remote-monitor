{
  "version": 2,
  "builds": [
    {
      "src": "lib/server/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "lib/**",
          "translations/**",
          "views/**",
          "static/**",
          "bundle/**",
          "assets/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "lib/server/server.js"
    }
  ],
  "headers": [
    {
      "source": "/translations/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/bundle/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}