{
  "version": 2,
  "builds": [
    {
      "src": "lib/server/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "lib/**",
          "translations/**",
          "views/**",
          "static/**",
          "bundle/**",
          "assets/**"
        ]
      }
    },
    {
      "src": "api/envtest.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/envtest",
      "dest": "api/envtest.js"
    },
    {
      "src": "/(.*)",
      "dest": "lib/server/server.js"
    }
  ]
}